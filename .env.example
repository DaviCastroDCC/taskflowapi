# Copy to .env and adjust. docker-compose reads this automatically; for `mvn spring-boot:run`
# export the variables into your shell first.
#
# `docker compose up` works without a .env (it falls back to a dev JWT secret and the
# default db credentials); set TASKFLOW_JWT_SECRET here for anything you keep running.

TASKFLOW_DB_URL=jdbc:postgresql://localhost:5432/taskflow
TASKFLOW_DB_USER=taskflow
TASKFLOW_DB_PASSWORD=taskflow

# Base64 or plain text, minimum 32 bytes. Generate one with:
#   openssl rand -base64 48
TASKFLOW_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-data

SERVER_PORT=8080
